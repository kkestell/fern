extern fn malloc(bytes: uint) -> *u8;
extern fn free(memory: *u8) -> void;
extern fn exit(status: i32) -> void;

fn main() -> void {
    var memory = malloc(sizeof([3]int));
    if memory == null {
        exit(1);
    }
    var values = *int(memory);
    values[0] = 10;
    values[1] = 20;
    values[2] = 30;
    var end = values + 3;
    if end - values != 3 || *(end - 1) != 30 {
        exit(2);
    }
    free(memory);

    var local = 1;
    var pointer: *int = null;
    pointer = &local;
    *pointer = 2;
    if local != 2 {
        exit(3);
    }
}
