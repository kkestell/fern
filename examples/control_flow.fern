fn main() -> void {
    var total = 0;

    if true && !false {
        total += 1;
    } else {
        exit(255);
    }

    for var i = 0; i < 4; i += 1 {
        if i == 1 {
            continue;
        }
        total += 1;
    }

    for total < 5 {
        total += 1;
    }

    for :done {
        for var i = 0; i < 2; i += 1 {
            if i == 1 {
                break :done;
            }
            total += 1;
        }
    }

    if total == 6 {
        exit(total);
    }
    exit(255);
}
