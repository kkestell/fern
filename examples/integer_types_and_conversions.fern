extern fn exit(status: i32) -> void;

fn main() -> void {
    var signed: i8 = -1;
    var unsigned = u8(signed);
    var narrowed = i8(511);
    var widened = i64(signed);
    var native = int(widened);
    if unsigned != 255 || narrowed != -1 || widened != -1 || native != -1 {
        exit(1);
    }
}
