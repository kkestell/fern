extern fn exit(status: i32) -> void;

fn main() -> void {
    var n = 0;
    var total = 0;
    for n < 5 {
        n += 1;
        if n == 3 {
            continue;
        }
        total += n;
    }
    for {
        if total == 12 {
            break;
        } else {
            exit(1);
        }
    }
}
