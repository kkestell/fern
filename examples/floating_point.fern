extern fn exit(status: i32) -> void;

fn main() -> void {
    var x: f32 = 0.1;
    var y: f64 = 0.1;
    var fraction = -127.9;
    var integer = i8(fraction);
    var zero = 0.0;
    var infinity = 1.0 / zero;
    var nan = zero / zero;
    const expected = 1.0 / 0.0;
    if x != f32(y) || integer != -127 || infinity != expected || nan == nan {
        exit(1);
    }
}
