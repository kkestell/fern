type Point struct {
    x: int,
    y: int,
}

type Node struct {
    value: int,
    next: nullable *Node,
}

// Heap allocation: `new` copies its operand into a heap target.
fn heap_allocation() -> int {
    var p = new(Point { x = 1, y = 2 });
    var n = new(0);
    p.x = 5;
    return p.x;
}

// Address of a location: a pointer to a local writes the local.
fn address_of_a_location() -> int {
    var p = Point { x = 1, y = 2 };
    const a = &p;
    a.x = 5;
    return p.x;
}

// Access through a pointer: reading `*p` copies the target.
fn access_through_a_pointer() -> int {
    var p = new([10, 20, 30]);
    p[1] = 25;
    var copy = *p;
    copy[0] = 0;
    return p[0] + p[1];
}

// Nullable pointers: a linked list ends at `null`.
fn sum(list: nullable *Node) -> int {
    var total = 0;
    var cursor = list;
    for cursor != null {
        const node = *Node(cursor);
        total += node.value;
        cursor = node.next;
    }
    return total;
}

fn nullable_pointers() -> int {
    const tail = new(Node { value = 2, next = null });
    const head = new(Node { value = 1, next = tail });
    return sum(head);
}

// Pointer comparison: pointers are equal when they share a target.
fn pointer_comparison() -> int {
    var a = new(1);
    var b = new(1);
    const c = a;
    if a == b {
        return 1;
    }
    if a == c {
        return 0;
    }
    return 2;
}

fn main() -> void {
    if heap_allocation() != 5 {
        exit(1);
    }
    if address_of_a_location() != 5 {
        exit(2);
    }
    if access_through_a_pointer() != 35 {
        exit(3);
    }
    if nullable_pointers() != 3 {
        exit(4);
    }
    if pointer_comparison() != 0 {
        exit(5);
    }
    exit(42);
}
