extern fn exit(status: i32) -> void;

fn changed(values: [3]int) -> [3]int {
    values[0] = 10;
    return values;
}

fn main() -> void {
    var original = [1, 2, 3];
    var copy = changed(original);
    var i = 0;
    var total = 0;
    for i < len(copy) {
        total += copy[i];
        i += 1;
    }
    if original[0] != 1 || total != 15 || copy == original {
        exit(1);
    }
}
