extern fn exit(status: i32) -> void;

fn factorial(n: int) -> int {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn increment(value: int) -> int {
    value += 1;
    return value;
}

fn main() -> void {
    var value = 5;
    if increment(value) != 6 || value != 5 || factorial(value) != 120 {
        exit(1);
    }
}
