extern fn exit(status: i32) -> void;

type Point struct {
    x: f64,
    y: f64,
}

fn translated(point: Point) -> Point {
    point.x += 1.0;
    return point;
}

fn main() -> void {
    var original = Point { x = 1.0, y = 2.0 };
    var copy = translated(original);
    var pointer = &copy;
    (*pointer).y = 3.0;
    if original.x != 1.0 || copy.x != 2.0 || copy.y != 3.0 {
        exit(1);
    }
}
