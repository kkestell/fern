extern fn exit(status: i32) -> void;

fn main() -> void {
    var byte: u8 = 255;
    byte += 1;
    var bits: u16 = 1;
    bits <<= 8;
    var quotient = 17 / 5;
    var remainder = 17 % 5;
    if byte != 0 || bits != 256 || quotient != 3 || remainder != 2 {
        exit(1);
    }
    var mask = ^bits;
    var combined = (bits | 3) ^ 1;
}
